{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PowerShell Runner Configuration",
  "description": "Configuration file for the PowerShell build & run script",
  "type": "object",
  "required": ["projectName", "backendDir"],
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Display name for the project shown in console output",
      "examples": ["LLM Runner", "Spec Management Software", "My App"]
    },
    "rootDir": {
      "type": "string",
      "default": ".",
      "description": "Root directory of the project (relative to script location)"
    },
    "backendDir": {
      "type": "string",
      "description": "Path to Go backend directory containing main.go",
      "examples": ["go-backend", "backend", "server", "packages/api"]
    },
    "frontendDir": {
      "type": "string",
      "default": ".",
      "description": "Path to React frontend directory containing package.json"
    },
    "distDir": {
      "type": "string",
      "default": "dist",
      "description": "Frontend build output directory (relative to frontendDir)"
    },
    "targetDir": {
      "type": "string",
      "description": "Where to copy built frontend for serving by Go backend",
      "examples": ["go-backend/frontend/dist", "server/static", "packages/api/public"]
    },
    "dataDir": {
      "type": "string",
      "description": "Data directory for SQLite databases and storage files",
      "examples": ["go-backend/data", "data", "server/data"]
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "default": [8080],
      "description": "Ports to open in Windows Firewall with -OpenFirewall flag"
    },
    "prerequisites": {
      "type": "object",
      "properties": {
        "go": {
          "type": "boolean",
          "default": true,
          "description": "Check/install Go runtime"
        },
        "node": {
          "type": "boolean",
          "default": true,
          "description": "Check/install Node.js"
        },
        "npm": {
          "type": "boolean",
          "default": true,
          "description": "Verify npm is available"
        },
        "bun": {
          "type": "boolean",
          "default": false,
          "description": "Check/install Bun runtime (alternative to npm)"
        }
      },
      "additionalProperties": false,
      "description": "Which prerequisites to check and auto-install"
    },
    "cleanPaths": {
      "type": "array",
      "items": {"type": "string"},
      "default": ["node_modules", "dist", ".vite"],
      "description": "Paths to remove when using -Force flag. Supports wildcards.",
      "examples": [
        ["node_modules", "dist", ".vite"],
        ["node_modules", "dist", ".vite", "go-backend/data/*.db"]
      ]
    },
    "buildCommand": {
      "type": "string",
      "default": "npm run build",
      "description": "Command to build the frontend",
      "examples": ["npm run build", "bun run build", "yarn build"]
    },
    "installCommand": {
      "type": "string",
      "default": "npm install",
      "description": "Command to install frontend dependencies",
      "examples": ["npm install", "bun install", "yarn install"]
    },
    "runCommand": {
      "type": "string",
      "default": "go run main.go",
      "description": "Command to start the Go backend",
      "examples": ["go run main.go", "go run cmd/server/main.go", "./server"]
    },
    "seedingDir": {
      "type": "string",
      "description": "Directory for seed data files (created automatically)",
      "examples": ["go-backend/data/seeding", "data/seeds"]
    },
    "configFile": {
      "type": "string",
      "default": "config.json",
      "description": "Backend configuration file name"
    },
    "configExampleFile": {
      "type": "string",
      "default": "config.example.json",
      "description": "Template config file to copy if main config is missing"
    },
    "requiredModules": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "NPM modules that trigger reinstall if missing (catches new deps after git pull)",
      "examples": [["react-syntax-highlighter", "marked"]]
    },
    "env": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Environment variables to set before running commands",
      "examples": [{"NODE_ENV": "production", "GO_ENV": "development"}]
    }
  },
  "additionalProperties": false
}
