{
  "version": "1.0.0",
  "category": "confidence_metrics",
  "description": "Confidence analysis weights and thresholds for source reliability scoring",
  "values": {
    "weights": {
      "source_agreement": 0.40,
      "data_freshness": 0.25,
      "source_count_confidence": 0.20,
      "authority_diversity": 0.15
    },
    "thresholds": {
      "min_sources_for_high_confidence": 10,
      "freshness_decay_days": 365,
      "contradiction_penalty": 0.70,
      "low_confidence_threshold": 0.40,
      "high_confidence_threshold": 0.75
    },
    "expert_domains": [
      "arxiv.org",
      "scholar.google.com",
      "researchgate.net",
      ".edu",
      ".gov",
      "nature.com",
      "sciencedirect.com",
      "ieee.org",
      "acm.org"
    ],
    "warnings": {
      "low_confidence": "⚠️ Low confidence—limited or conflicting sources",
      "contradiction_detected": "⚠️ Findings contradictory—use caution",
      "stale_data": "⚠️ Data may be outdated—verify with recent sources",
      "single_source": "⚠️ Single source only—seek additional verification"
    },
    "freshness_decay": {
      "half_life_days": 180,
      "min_score": 0.10,
      "max_age_days": 1825
    },
    "agreement_detection": {
      "similarity_threshold": 0.85,
      "min_claims_for_consensus": 3,
      "contradiction_similarity_threshold": 0.30
    }
  }
}
