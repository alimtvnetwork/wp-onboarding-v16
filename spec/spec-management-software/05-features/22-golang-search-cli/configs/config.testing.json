{
  "$schema": "./config.schema.json",
  "environment": "testing",
  
  "database": {
    "path": ":memory:",
    "maxOpenConns": 1,
    "maxIdleConns": 1,
    "connMaxLifetime": "1m",
    "enableLogging": true,
    "logLevel": "debug"
  },
  
  "search": {
    "maxConcurrency": 1,
    "requestDelay": "0ms",
    "timeout": "5s",
    "maxResultsPerEngine": 5,
    "enableProgressOutput": false,
    "retryAttempts": 1,
    "retryDelay": "100ms",
    "methodWeights": {
      "html": 0.34,
      "google_api": 0.33,
      "duckduckgo": 0.33,
      "bing": 0.00
    }
  },
  
  "engines": {
    "google": {
      "enabled": true,
      "weight": 0.34,
      "methods": {
        "html": {
          "enabled": true,
          "weight": 1.00
        },
        "customSearch": {
          "enabled": false,
          "weight": 0.00,
          "apiKey": "test-api-key",
          "searchEngineId": "test-engine-id",
          "dailyQuotaLimit": 10
        },
        "searchConsole": {
          "enabled": false,
          "weight": 0.00,
          "credentialsPath": "./testdata/mock-credentials.json"
        }
      },
      "cooldown": "0ms",
      "maxRequestsPerMinute": 1000
    },
    "duckduckgo": {
      "enabled": true,
      "weight": 0.33,
      "methods": {
        "html": {
          "enabled": true,
          "weight": 0.50
        },
        "instantAnswer": {
          "enabled": true,
          "weight": 0.50
        }
      },
      "cooldown": "0ms",
      "maxRequestsPerMinute": 1000
    },
    "bing": {
      "enabled": true,
      "weight": 0.33,
      "methods": {
        "html": {
          "enabled": true,
          "weight": 1.00
        },
        "api": {
          "enabled": false,
          "weight": 0.00,
          "apiKey": "test-bing-key",
          "maxRequestsPerSecond": 1000
        }
      },
      "cooldown": "0ms",
      "maxRequestsPerMinute": 1000
    }
  },
  
  "blocking": {
    "detectionEnabled": true,
    "cooldown": "0ms",
    "maxConsecutiveBlocks": 10,
    "autoSwitchOnBlock": true,
    "blockIndicators": {
      "google": ["unusual traffic", "captcha"],
      "duckduckgo": ["rate limit"],
      "bing": ["blocked"]
    }
  },
  
  "backoff": {
    "initialDelay": "10ms",
    "maxDelay": "100ms",
    "multiplier": 1.5,
    "jitter": 0.0
  },
  
  "cache": {
    "enabled": true,
    "ttlDays": 1,
    "maxEntries": 100,
    "autoCleanup": false,
    "cleanupInterval": "0ms",
    "trackHitRate": true
  },
  
  "nested": {
    "enabled": true,
    "maxDepth": 1,
    "keywordsPerPage": 2,
    "maxPagesPerLevel": 2,
    "cycleDetection": true,
    "extractionMethod": "simple",
    "minKeywordScore": 0.10
  },
  
  "pageContent": {
    "fetchEnabled": true,
    "maxConcurrentFetches": 1,
    "timeout": "5s",
    "maxContentSizeKb": 100,
    "extractImages": false,
    "extractLinks": true
  },
  
  "rag": {
    "chunkMaxTokens": 256,
    "chunkOverlapTokens": 25,
    "minChunkTokens": 50,
    "includeMetadata": true,
    "relevanceScoring": false
  },
  
  "output": {
    "defaultFormat": "json",
    "prettyPrint": true,
    "includeTimestamps": false,
    "colorOutput": false,
    "progressBar": false,
    "verboseErrors": true
  },
  
  "userAgent": {
    "rotationEnabled": false,
    "rotationStrategy": "fixed",
    "customAgents": ["TestBot/1.0 (Golang Search CLI Test Suite)"],
    "useDefaultAgents": false
  },
  
  "logging": {
    "level": "debug",
    "format": "text",
    "outputPath": "",
    "maxSizeMb": 1,
    "maxBackups": 0,
    "compress": false
  },
  
  "mock": {
    "enabled": true,
    "mockDataPath": "./testdata/mocks",
    "recordResponses": false,
    "playbackMode": "strict"
  }
}
