{
  "version": "1.18.0",
  
  "databasePath": "data/app.db",
  "tempDir": ".temp",
  "server": {
    "port": 8080,
    "wsReconnectDelayMs": 3000,
    "staticDir": "frontend/dist"
  },
  "watcher": {
    "mode": "hybrid",
    "pollingEnabled": false,
    "scanAfterGitPull": true,
    "defaultExcludePatterns": [".git", "node_modules", ".DS_Store", "*.log", ".temp", "vendor", ".idea", ".vscode"]
  },
  "backup": {
    "location": "backups",
    "autoBackupOnPublish": true,
    "retentionDays": 30,
    "maxBackupsPerPlugin": 10
  },
  "logging": {
    "level": "info",
    "retentionDays": 7,
    "debugMode": false,
    "timeFormat": "2006-01-02 03:04:05 PM",
    "frontendDebugMode": false,
    "retryMaxAttempts": 3,
    "retryInitialDelayMs": 1000,
    "circuitBreakerThreshold": 5,
    "circuitBreakerCooldownMs": 60000
  },
  "wordpress": {
    "timeoutSeconds": 30,
    "maxRetries": 3
  },
  "seed": {
    "enabled": true,
