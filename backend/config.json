{
  "Version": "2.11.0",

  "DatabasePath": "data/app.db",
  "TempDir": ".temp",
  "Server": {
    "Port": 8080,
    "WsReconnectDelayMs": 3000,
    "StaticDir": "frontend/dist"
  },
  "Watcher": {
    "Mode": "hybrid",
    "PollingEnabled": false,
    "ScanAfterGitPull": true,
    "DefaultExcludePatterns": [".git", "node_modules", ".DS_Store", "*.log", ".temp", "vendor", ".idea", ".vscode"]
  },
  "Backup": {
    "Location": "backups",
    "AutoBackupOnPublish": true,
    "RetentionDays": 30,
    "MaxBackupsPerPlugin": 10
  },
  "Logging": {
    "Level": "Info",
    "RetentionDays": 7,
    "DebugMode": false,
    "TimeFormat": "2006-01-02 03:04:05 PM",
    "ClearLogsOnStartup": false,
    "ClearSessionsOnStartup": false,
    "SessionLoggingEnabled": true,
    "FrontendDebugMode": false,
    "RetryMaxAttempts": 3,
    "RetryInitialDelayMs": 1000,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerCooldownMs": 60000,
    "StackTraceDepth": 20,
    "PhpStackTraceDepth": 0
  },
  "ResponseDebug": {
    "IncludeStackTrace": true,
    "IncludeInternalErrors": true,
    "IncludeMethodsStack": true,
    "MaxStackFrames": 20
  },
  "WordPress": {
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "RemotePlugins": {
    "CacheEnabled": true,
    "CacheTTLMinutes": 60
  },
  "Snapshot": {
    "Mode": "PerTable",
    "BackupType": "Incremental",
    "WorkerCount": 10,
    "StoragePath": "snapshots/",
    "IncludePlugins": true,
    "PluginSelection": "All",
    "RetentionDays": 30,
    "RetentionCount": 10,
    "Compression": true,
    "BatchSize": 1000
  },
