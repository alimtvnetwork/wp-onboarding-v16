{
  "$schema": "./spec/powershell-integration/schemas/powershell.schema.json",
  "version": "2.2.0",
  "projectName": "WP Plugin Publish",
  "rootDir": ".",
  "backendDir": "backend",
  "frontendDir": ".",
  "distDir": "dist",
  "targetDir": "backend/frontend/dist",
  "dataDir": "backend/data",
  "ports": [8080],
  "prerequisites": {
    "go": true,
    "node": true,
    "pnpm": true
  },
  "usePnp": true,
  "pnpmStorePath": "E:/.pnpm-store",
  "cleanPaths": [
    "dist",
    ".vite",
    ".pnp.cjs",
    ".pnp.loader.mjs",
    "backend/data/*.db",
    "backend/data/*.db-shm",
    "backend/data/*.db-wal",
    "backend/data/sessions",
    "backend/data/request-sessions",
    "backend/data/errors"
  ],
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "runCommand": "go run ./cmd/server",
  "configFile": "config.json",
  "configExampleFile": "config.example.json",
  "requiredModules": [
    "react",
    "react-dom",
    "lucide-react"
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "wpPlugins": {
    "defaultUploader": "riseup-asia-uploader",
    "defaultQUploader": "qupload",
    "pluginsDir": "wp-plugins",
    "skipPlugins": ["plugins-onboard"],
    "plugins": {
      "riseup-asia-uploader": {
        "name": "Riseup Asia Uploader",
        "path": "wp-plugins/riseup-asia-uploader",
        "mainFile": "riseup-asia-uploader.php",
        "autoUpload": true
      },
      "plugins-onboard": {
        "name": "Plugins Onboard",
        "path": "wp-plugins/plugins-onboard",
        "mainFile": "plugins-onboard.php",
        "autoUpload": false
      },
      "qupload": {
        "name": "Quick Upload",
        "path": "wp-plugins/qupload",
        "mainFile": "qupload.php",
        "autoUpload": false
      }
    }
  }
}
