{
  "global_exclude": [
    "vendor/**",
    "node_modules/**",
    ".git/**",
    "*_test.go",
    "**/_generated/**",
    "**/e2e/**"
  ],
  "rules": [
    {
      "id": "go-file-size",
      "name": "Go File Size Limit",
      "enabled": true,
      "severity": "error",
      "languages": ["go"],
      "params": {
        "max_lines": 300
      },
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-file-size"
    },
    {
      "id": "go-func-size",
      "name": "Go Function Body Size",
      "enabled": true,
      "severity": "error",
      "languages": ["go"],
      "params": {
        "max_lines": 15
      },
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-func-size"
    },
    {
      "id": "go-single-return",
      "name": "Go Single Return Value",
      "enabled": true,
      "severity": "error",
      "languages": ["go"],
      "params": {},
      "exclude": ["*_test.go", "pkg/apperror/**"],
      "reference": "spec/03-rules.md#go-single-return"
    },
    {
      "id": "go-import-groups",
      "name": "Go Import Grouping",
      "enabled": true,
      "severity": "warning",
      "languages": ["go"],
      "params": {
        "groups": 3
      },
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-import-groups"
    },
    {
      "id": "go-param-count",
      "name": "Go Parameter Count",
      "enabled": true,
      "severity": "warning",
      "languages": ["go"],
      "params": {
        "max_params": 3
      },
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-param-count"
    },
    {
      "id": "go-inline-if",
      "name": "Go Inline If-Init",
      "enabled": true,
      "severity": "error",
      "languages": ["go"],
      "params": {},
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-inline-if"
    },
    {
      "id": "file-naming",
      "name": "Go File Naming Convention",
      "enabled": true,
      "severity": "warning",
      "languages": ["go"],
      "params": {
        "convention": "PascalCase"
      },
      "exclude": ["*_test.go", "go.mod", "go.sum"],
      "reference": "spec/03-rules.md#file-naming"
    },
    {
      "id": "go-abbr-casing",
      "name": "Go Abbreviation Casing",
      "enabled": true,
      "severity": "warning",
      "languages": ["go"],
      "params": {},
      "exclude": ["*_test.go"],
      "reference": "spec/03-rules.md#go-abbr-casing"
    },
    {
      "id": "go-raw-error",
      "name": "Go Raw Error Return",
      "enabled": true,
      "severity": "error",
      "languages": ["go"],
      "params": {},
      "exclude": ["*_test.go", "pkg/apperror/**", "pkg/pathutil/**", "internal/database/dbops/**", "internal/enums/**", "cmd/**"],
      "reference": "spec/03-rules.md#go-raw-error"
    },
    {
      "id": "php-file-size",
      "name": "PHP File Size Limit",
      "enabled": true,
      "severity": "warning",
      "languages": ["php"],
      "params": {
        "max_lines": 500
      },
      "exclude": [],
      "reference": "spec/03-rules.md#php-file-size"
    },
    {
      "id": "md-heading",
      "name": "Single H1 Heading",
      "enabled": true,
      "severity": "info",
      "languages": ["md"],
      "params": {},
      "exclude": [],
      "reference": "spec/03-rules.md#md-heading"
    }
  ]
}
